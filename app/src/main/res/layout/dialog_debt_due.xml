<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/due_help" android:textSize="14sp" android:layout_marginBottom="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dueDateButton" style="@style/FilledButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dueClearButton" style="@style/OutlineButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/due_clear" />
        <androidx.appcompat.widget.AppCompatCheckBox android:id="@+id/dueReminderSwitch" style="@style/defaultRadioButtons"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/due_enable" android:clickable="true" android:focusable="true" android:minHeight="48dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dueTimeButton" style="@style/OutlineButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/duePermissionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/due_permission_denied" android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/dueNotificationSettings" style="@style/OutlineButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/due_notification_settings" />
        <TextView android:id="@+id/dueError" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
    </LinearLayout>
</ScrollView>
