<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="72dp" android:background="?android:attr/selectableItemBackground"
    android:clickable="true" android:focusable="true" android:orientation="vertical" android:padding="16dp">
    <TextView android:id="@+id/copyTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/copyDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="16sp" />
</LinearLayout>
